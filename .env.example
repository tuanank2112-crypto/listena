# ── Database ──────────────────────────────────────────
# SQLite for local development
DATABASE_URL="file:./dev.db"

# Turso is used only for hosted Preview/Production. Set APP_RUNTIME=vercel in
# the Vercel dashboard together with both values; never put a real token here.
# APP_RUNTIME=vercel
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# MIGRATION_WRITE_MODE=disabled

# ── Authentication ────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production-listena-local-dev"

# ── Email delivery ───────────────────────────────────
# Resend delivers verification, password-reset, and feedback emails. Configure
# the key and verified sender only through the local secret manager or Vercel.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# A Resend-verified sender, for example: ListenAI <noreply@example.com>
EMAIL_FROM=
# Inbox that receives authenticated learner feedback.
SUPPORT_EMAIL=
# Optional verified mailbox used as Reply-To for transactional messages. A
# feedback receipt falls back to SUPPORT_EMAIL so a learner can reply safely.
EMAIL_REPLY_TO=

# ── AI Provider ───────────────────────────────────────
# The deployed provider is Vyce AI (decision 2026-09-17: Vyce only; the earlier
# Kira provider and its KIRAAI_* variables were removed and are rejected).
# Leave the key blank in local clones unless it has been supplied through your
# local secret manager; unavailable is explicit and there is no runtime mock.
AI_PROVIDER=vyce
# Required when AI_PROVIDER=vyce; never commit a real value.
VYCE_API_KEY=
# The model id MUST exist in the Vyce catalogue, otherwise every tutor call
# fails with 404 `model_not_found` and the learner only ever sees the generic
# "Gia sư AI hiện chưa sẵn sàng" state. Verify before changing:
#   npm run ai:doctor -- --probe
VYCE_MODEL=claude-sonnet-4-6
# OpenAI-compatible Chat Completions endpoint. Only this exact endpoint is
# accepted (allowlist in `src/server/ai/vyce-chat-completions-provider.ts`), so
# the API key can never be redirected to another host by configuration alone.
VYCE_BASE_URL=https://vyceai.com/v1

# Alternative provider: set AI_PROVIDER=openai and configure these values
# instead. Do not use OPENAI_* merely to point at Vyce: their wire contracts
# differ (OpenAI Responses versus Vyce Chat Completions).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── VieNeu Sidecar (tiếng Việt) ───────────────────────
# Địa chỉ HTTP của sidecar VieNeu TTS (chạy FastAPI riêng, chỉ bind loopback).
VIENEU_URL=http://localhost:8001
# Bí mật chia sẻ giữa Next.js và sidecar; không commit giá trị thật.
TTS_API_KEY=
# Authenticated Next.js audio cache (giữ ngoài public/).
TTS_PROXY_CACHE_DIR=tts-service/cache/proxy
# Thư mục lưu audio sinh sẵn của sidecar (prebuild), mặc định public/tts.
TTS_CACHE_DIR=public/tts
# Giọng VieNeu mặc định cho nội dung tiếng Việt; đọc từ runtime khi có thể.
VIENEU_DEFAULT_VOICE=

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=info
