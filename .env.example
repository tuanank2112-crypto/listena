# ── Database ──────────────────────────────────────────
# SQLite for local development
DATABASE_URL="file:./dev.db"

# ── Authentication ────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production-listena-local-dev"

# ── AI Provider ───────────────────────────────────────
# Options: mock | openai
AI_PROVIDER=mock
# Only needed when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Giọng đọc ─────────────────────────────────────────
# Model Kokoro tải phía trình duyệt khi người học yêu cầu phát âm thanh.
NEXT_PUBLIC_KOKORO_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
# Giọng Kokoro mặc định, dùng thống nhất ở trình duyệt và lệnh prebuild.
NEXT_PUBLIC_KOKORO_DEFAULT_VOICE=bf_emma

# ── VieNeu Sidecar (tiếng Việt) ───────────────────────
# Địa chỉ HTTP của sidecar VieNeu TTS (chạy FastAPI riêng, không public).
VIENEU_URL=http://localhost:8001
# Bí mật chia sẻ giữa Next.js và sidecar; không commit giá trị thật.
TTS_API_KEY=
# Authenticated Next.js audio cache (keep outside public/).
TTS_PROXY_CACHE_DIR=tts-service/cache/proxy
# Thư mục lưu audio sinh sẵn (prebuild), mặc định public/tts.
TTS_CACHE_DIR=public/tts
# Model id và giọng Kokoro dùng cho script prebuild phía Node.
KOKORO_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_DEFAULT_VOICE=bf_emma
# Giọng VieNeu mặc định cho nội dung tiếng Việt; đọc từ runtime khi có thể.
VIENEU_DEFAULT_VOICE=

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=info
